+def _checkpoint_dir(path: Path) -> Optional[Path]:
+    """Return a directory that contains DA3 config and weights.
+
+    Hugging Face stores the real files under ``snapshots/<rev>/``, not in the
+    cache repo root.
+    """
+    if (path / "config.json").is_file() and (path / "model.safetensors").is_file():
+        return path
+    snapshots = path / "snapshots"
+    if not snapshots.is_dir():
+        return None
+    for snap in snapshots.iterdir():
+        if (snap / "config.json").is_file() and (snap / "model.safetensors").is_file():
+            return snap
+    return None
+
